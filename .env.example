# CAPTCHA configuration
CAPTCHA_PROVIDER=mock
CAPTCHA_API_KEY=
CAPTCHA_POLL_INTERVAL_SEC=5
CAPTCHA_TIMEOUT_SEC=120
ALLOW_EXTERNAL_CAPTCHA_SOLVER=false
ALLOWED_CAPTCHA_DOMAINS=

# Politeness policy
POLITENESS_MAX_RPS_PER_HOST=0.35
POLITENESS_MAX_CONCURRENCY_PER_HOST=1
POLITENESS_JITTER_MIN_MS=200
POLITENESS_JITTER_MAX_MS=800
POLITENESS_MAX_RETRIES=3
POLITENESS_INITIAL_RETRY_DELAY_MS=2000
POLITENESS_RETRY_BACKOFF=2
POLITENESS_RESPECT_ROBOTS=true
POLITENESS_MAX_CAPTCHA_RETRIES=3
